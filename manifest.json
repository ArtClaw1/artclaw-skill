{
  "name": "artclaw-creative-suite",
  "version": "2.0.0",
  "displayName": "ARTCLAW AI Creative Suite",
  "description": "Discover current ARTCLAW nodes and execute single-step or multi-step DSL workflows through a stable CLI.",
  "author": {
    "name": "ARTCLAW Team",
    "url": "https://artclaw.com/"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "image-generation",
    "video-generation",
    "audio-generation",
    "bgm",
    "background-music",
    "model-selection",
    "text-generation",
    "voice-stt",
    "voice-tts",
    "rest-api",
    "artclaw",
    "creative",
    "text-to-image",
    "text-to-video",
    "ai-painting",
    "virtual-human",
    "asset-library"
  ],
  "skill": "SKILL.md",
  "main": "__init__.py",
  "scripts": {
    "feishu_send_video": {
      "path": "scripts/feishu_send_video.py",
      "description": "Send video/image messages via Feishu (upload file → get file_key → send media message)",
      "runtime": "python3",
      "dependencies": ["requests"],
      "credentials": "~/.openclaw/openclaw.json → channels.feishu"
    },
    "telegram_send_video": {
      "path": "scripts/telegram_send_video.py",
      "description": "Send video messages via Telegram Bot API (sendVideo, supports thumbnail and caption)",
      "runtime": "python3",
      "dependencies": ["requests"],
      "credentials": "TELEGRAM_BOT_TOKEN environment variable"
    },
    "artclaw": {
      "path": "scripts/artclaw.py",
      "description": "Workflow discovery, validation, submission, request recovery and job management. JSON output with platform background execution support.",
      "runtime": "python3",
      "dependencies": ["requests"],
      "credentials": "ARTCLAW_API_KEY environment variable"
    }
  },
  "api": {
    "baseUrl": "https://artclaw.com/api/v1",
    "transport": "http",
    "endpoints": {
      "media": {
        "upload": {
          "method": "POST",
          "path": "/assets/upload",
          "description": "Authenticated local image/video/audio upload before generation"
        }
      },
      "jobs": {
        "get": {
          "method": "GET",
          "path": "/jobs/{job_id}"
        },
        "list": {
          "method": "GET",
          "path": "/jobs/"
        },
        "cancel": {
          "method": "POST",
          "path": "/jobs/{job_id}/cancel"
        }
      },
      "account": {
        "info": {
          "method": "GET",
          "path": "/account/info"
        }
      },
      "auth": {
        "verify": {
          "method": "POST",
          "path": "/auth/verify"
        }
      },
      "voices": {
        "list": {
          "method": "GET",
          "path": "/voices",
          "description": "Read-only voice discovery for supported workflow inputs."
        }
      },
      "workflows": {
        "nodes": {
          "method": "GET",
          "path": "/workflows/nodes"
        },
        "describe": {
          "method": "GET",
          "path": "/workflows/nodes/{node_type}"
        },
        "guide": {
          "method": "GET",
          "path": "/workflows/dsl-guide"
        },
        "templates": { "method": "GET", "path": "/workflows/templates" },
        "template": { "method": "GET", "path": "/workflows/templates/{name}" },
        "validate": {
          "method": "POST",
          "path": "/workflows/validate"
        },
        "run": {
          "method": "POST",
          "path": "/workflows/run"
        },
        "recover": {
          "method": "GET",
          "path": "/workflows/requests/{request_id}"
        }
      }
    }
  },
  "auth": {
    "type": "apiKey",
    "headerName": "X-API-KEY",
    "paramLocation": "header",
    "prefix": "vk_",
    "required": true,
    "helpUrl": "https://artclaw.com/settings",
    "helpText": "Create an API Key in ARTCLAW Settings > API Keys. The key starts with vk_",
    "publicPaths": ["/api/v1/auth/verify"]
  },
  "metadata": {
    "openclaw": {
      "emoji": "🎨",
      "requires": {
        "env": ["ARTCLAW_API_KEY"]
      },
      "primaryEnv": "ARTCLAW_API_KEY",
      "envMapping": {
        "ARTCLAW_API_KEY": "X-API-KEY"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ArtClaw1/artclaw-skill.git",
    "branch": "main"
  },
  "update": {
    "method": "tarball",
    "url": "https://github.com/ArtClaw1/artclaw-skill/archive/refs/heads/main.tar.gz"
  },
  "install": {
    "steps": [
      "Create an API key at https://artclaw.com/settings",
      "Set ARTCLAW_API_KEY locally",
      "Follow SKILL.md to discover and run workflows through scripts/artclaw.py"
    ]
  }
}
